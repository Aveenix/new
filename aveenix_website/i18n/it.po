#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Privacy Policy"
msgstr "Informativa sulla privacy"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "This Privacy Policy explains how Aveenix collects, uses, stores, and protects your personal information when you use our services."
msgstr "La presente Informativa sulla privacy spiega come Aveenix raccoglie, utilizza, archivia e protegge le tue informazioni personali quando utilizzi i nostri servizi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<i class=\"fa fa-calendar\"/> Last updated: 20 May 2024"
msgstr "<i class=\"fa fa-calendar\"/> Ultimo aggiornamento: 20 maggio 2024"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Policy Topics"
msgstr "Argomenti politici"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "This Privacy Policy applies to Aveenix Express, owned and operated by Aveenix Global Ltd (\"Aveenix\", \"we\", \"us\", or \"our\"), and covers our website, related services, and any features or tools provided through the platform. By using our Services, you agree to the practices described here. Explore the topics below to learn more about how we handle your information."
msgstr "La presente Informativa sulla privacy si applica ad Aveenix Express, di proprietà e gestito da Aveenix Global Ltd (\"Aveenix\", \"noi\", \"ci\" o \"nostro\") e copre il nostro sito Web, i servizi correlati e qualsiasi funzionalità o strumento fornito attraverso la piattaforma. Utilizzando i nostri Servizi, accetti le pratiche qui descritte. Esplora gli argomenti seguenti per saperne di più su come gestiamo le tue informazioni."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Information We Collect</strong>\n                                                    <span>Learn about the types of personal information we collect from you.</span>"
msgstr "<strong>Informazioni che raccogliamo</strong>\n                                                    <span>Scopri i tipi di informazioni personali che raccogliamo da te.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We collect personal information only where necessary to operate our Services and provide a smooth shopping experience."
msgstr "Raccogliamo informazioni personali solo ove necessario per gestire i nostri Servizi e fornire un'esperienza di acquisto fluida."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Personal Information:</strong> full name, email address, phone number, billing and shipping address, and payment-related information (processed securely via third-party payment providers)."
msgstr "<strong>Informazioni personali:</strong> nome completo, indirizzo e-mail, numero di telefono, indirizzo di fatturazione e spedizione e informazioni relative al pagamento (elaborate in modo sicuro tramite fornitori di servizi di pagamento di terze parti)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Account Information:</strong> login credentials, order history, rewards or cashback balance, and saved preferences."
msgstr "<strong>Informazioni sull'account:</strong> credenziali di accesso, cronologia degli ordini, saldo dei premi o del cashback e preferenze salvate."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Transaction Information:</strong> orders placed through Aveenix checkout, affiliate click tracking (non-payment data only), and refunds or cancellations."
msgstr "<strong>Informazioni sulla transazione:</strong> ordini effettuati tramite il checkout Aveenix, il monitoraggio dei clic di affiliazione (solo dati non di pagamento) e rimborsi o cancellazioni."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Automatically Collected:</strong> IP address, device type and browser information, pages visited and interaction data, and cookies or similar tracking technologies."
msgstr "<strong>Raccolti automaticamente:</strong> Indirizzo IP, tipo di dispositivo e informazioni sul browser, pagine visitate e dati di interazione, nonché cookie o tecnologie di tracciamento simili."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>From Third Parties:</strong> limited information from affiliate partners, payment processors (confirmation only), and analytics providers (aggregated, non-identifying data)."
msgstr "<strong>Da terze parti:</strong> informazioni limitate da partner affiliati, processori di pagamento (solo conferma) e fornitori di analisi (dati aggregati e non identificativi)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>How We Use Information</strong>\n                                                    <span>Understand how we use your personal information to provide our services.</span>"
msgstr "<strong>Come utilizziamo le informazioni</strong>\n                                                    <span>Comprendere come utilizziamo le tue informazioni personali per fornire i nostri servizi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We use your information for the following purposes:"
msgstr "Utilizziamo le tue informazioni per i seguenti scopi:"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Processing &amp; Fulfilment:</strong> to process orders, confirm payments, arrange delivery, and manage refunds for products sold directly through Aveenix."
msgstr "<strong>Elaborazione ed evasione degli ordini:</strong> per elaborare gli ordini, confermare i pagamenti, organizzare la consegna e gestire i rimborsi per i prodotti venduti direttamente tramite Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Customer Support:</strong> to respond to enquiries, resolve issues, and provide assistance."
msgstr "<strong>Assistenza clienti:</strong> per rispondere a domande, risolvere problemi e fornire assistenza."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Platform Operation &amp; Improvement:</strong> to maintain, improve, and optimise our website and Services."
msgstr "<strong>Funzionamento e miglioramento della piattaforma:</strong> per mantenere, migliorare e ottimizzare il nostro sito Web e i nostri Servizi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Personalisation (Optional):</strong> to customise content, product displays, or communications based on your interactions."
msgstr "<strong>Personalizzazione (opzionale):</strong> per personalizzare contenuti, visualizzazioni di prodotti o comunicazioni in base alle tue interazioni."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Marketing Communications:</strong> to send promotional messages or updates only where you have consented, with opt-out options available at all times."
msgstr "<strong>Comunicazioni di marketing:</strong> per inviare messaggi promozionali o aggiornamenti solo laddove hai acconsentito, con opzioni di rinuncia disponibili in ogni momento."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Legal &amp; Security Purposes:</strong> to prevent fraud, enforce platform policies, and comply with legal obligations."
msgstr "<strong>Scopi legali e di sicurezza:</strong> per prevenire frodi, applicare le politiche della piattaforma e rispettare gli obblighi legali."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Information Sharing</strong>\n                                                    <span>We do not sell your personal data. See when and why we share it.</span>"
msgstr "<strong>Condivisione delle informazioni</strong>\n                                                    <span>Non vendiamo i tuoi dati personali. Scopri quando e perché lo condividiamo.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We do not sell your personal information. We may share limited data only where necessary with:"
msgstr "Non vendiamo le tue informazioni personali. Potremmo condividere dati limitati solo ove necessario con:"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Service Providers</strong> such as payment processors, hosting providers, analytics tools, or customer support platforms."
msgstr "<strong>Fornitori di servizi</strong> come processori di pagamento, provider di hosting, strumenti di analisi o piattaforme di assistenza clienti."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Affiliate Partners</strong> when you click an affiliate link or complete a purchase on a third-party website, limited tracking data may be shared to confirm the transaction."
msgstr "<strong>Partner affiliati</strong> quando fai clic su un collegamento di affiliazione o completi un acquisto su un sito Web di terze parti, potrebbero essere condivisi dati di tracciamento limitati per confermare la transazione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Suppliers &amp; Fulfilment Partners</strong> where required to deliver products sold directly through Aveenix."
msgstr "<strong>Fornitori e partner logistici</strong> ove richiesto, per consegnare i prodotti venduti direttamente tramite Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Legal or Regulatory Authorities</strong> where required by law or to protect our legal rights."
msgstr "<strong>Autorità legali o di regolamentazione</strong> ove richiesto dalla legge o per proteggere i nostri diritti legali."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Cookies &amp; Tracking</strong>\n                                                    <span>How we use cookies and similar technologies to enhance your experience.</span>"
msgstr "<strong>Cookie e tracciamento</strong>\n                                                    <span>Come utilizziamo i cookie e tecnologie simili per migliorare la tua esperienza.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We use cookies and similar technologies to enable core website functionality, analyse website performance, and improve user experience."
msgstr "Utilizziamo cookie e tecnologie simili per abilitare le funzionalità principali del sito Web, analizzare le prestazioni del sito Web e migliorare l'esperienza dell'utente."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "You can manage or disable cookies through your browser settings. Please note that disabling cookies may affect certain website features."
msgstr "Puoi gestire o disabilitare i cookie attraverso le impostazioni del tuo browser. Tieni presente che la disabilitazione dei cookie potrebbe influire su alcune funzionalità del sito web."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Data Security</strong>\n                                                    <span>The security measures we use to protect your information.</span>"
msgstr "<strong>Sicurezza dei dati</strong>\n                                                    <span>Le misure di sicurezza che utilizziamo per proteggere le tue informazioni.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We take reasonable and appropriate steps to protect your personal information, including secure hosting environments, encrypted communications, and trusted third-party payment gateways."
msgstr "Adottiamo misure ragionevoli e appropriate per proteggere le tue informazioni personali, inclusi ambienti di hosting sicuri, comunicazioni crittografate e gateway di pagamento di terze parti affidabili."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "However, no system is completely secure, and we cannot guarantee absolute security of data transmitted online."
msgstr "Tuttavia, nessun sistema è completamente sicuro e non possiamo garantire la sicurezza assoluta dei dati trasmessi online."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Your Rights &amp; Choices</strong>\n                                                    <span>Your rights to access, update, delete, or control your personal data.</span>"
msgstr "<strong>I tuoi diritti e le tue scelte</strong>\n                                                    <span>I tuoi diritti di accesso, aggiornamento, cancellazione o controllo dei tuoi dati personali.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Depending on your location, you may have the right to access your personal information, correct or update inaccurate data, request deletion of your data (subject to legal obligations), and withdraw consent for marketing communications."
msgstr "A seconda della tua posizione, potresti avere il diritto di accedere alle tue informazioni personali, correggere o aggiornare dati inesatti, richiedere la cancellazione dei tuoi dati (soggetto a obblighi legali) e revocare il consenso per le comunicazioni di marketing."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Requests can be made via our Contact Us page."
msgstr "Le richieste possono essere effettuate tramite la nostra pagina Contattaci."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Data Retention</strong>\n                                                    <span>How long we keep your information and the criteria we use.</span>"
msgstr "<strong>Conservazione dei dati</strong>\n                                                    <span>Per quanto tempo conserviamo le tue informazioni e i criteri che utilizziamo.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We retain personal information only for as long as necessary to provide our Services, comply with legal, accounting, or regulatory requirements, and resolve disputes or enforce agreements."
msgstr "Conserviamo le informazioni personali solo per il tempo necessario a fornire i nostri Servizi, rispettare i requisiti legali, contabili o normativi e risolvere controversie o far rispettare accordi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "When data is no longer required, it is securely deleted or anonymised."
msgstr "Quando i dati non sono più necessari, vengono cancellati o resi anonimi in modo sicuro."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Children's Privacy</strong>\n                                                    <span>Our commitment to protecting the privacy of children online.</span>"
msgstr "<strong>Privacy dei bambini</strong>\n                                                    <span>Il nostro impegno per proteggere la privacy dei bambini online.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix Express is not intended for use by children under 18. We do not knowingly collect personal information from minors. If such data is identified, it will be deleted promptly."
msgstr "Aveenix Express non è destinato all'uso da parte di minori di 18 anni. Non raccogliamo consapevolmente informazioni personali da minori. Se tali dati vengono identificati, verranno cancellati tempestivamente."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>International Transfers</strong>\n                                                    <span>How your information may be transferred outside your country.</span>"
msgstr "<strong>Trasferimenti internazionali</strong>\n                                                    <span>Come le tue informazioni potrebbero essere trasferite al di fuori del tuo Paese.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Your information may be processed or stored outside your country of residence. Where this occurs, we take reasonable steps to ensure appropriate data protection safeguards are in place."
msgstr "Le tue informazioni potrebbero essere elaborate o archiviate al di fuori del tuo Paese di residenza. Laddove ciò si verifichi, adottiamo misure ragionevoli per garantire che siano adottate adeguate misure di protezione dei dati."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Third-Party Links</strong>\n                                                    <span>Our website may contain links to other sites. Learn more.</span>"
msgstr "<strong>Collegamenti di terze parti</strong>\n                                                    <span>Il nostro sito web può contenere collegamenti ad altri siti. Saperne di più.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Some products on Aveenix Express link to third-party websites. Purchases made on third-party websites are governed by their own privacy policies."
msgstr "Alcuni prodotti su Aveenix Express si collegano a siti Web di terzi. Gli acquisti effettuati su siti Web di terzi sono regolati dalle rispettive politiche sulla privacy."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix does not control how third parties collect or use your data. We encourage you to review their privacy practices before completing a purchase."
msgstr "Aveenix non controlla il modo in cui terze parti raccolgono o utilizzano i tuoi dati. Ti invitiamo a rivedere le loro pratiche sulla privacy prima di completare un acquisto."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Policy Updates</strong>\n                                                    <span>We may update this policy from time to time. See what's changed.</span>"
msgstr "<strong>Aggiornamenti politici</strong>\n                                                    <span>Potremmo aggiornare questa politica di tanto in tanto. Guarda cosa è cambiato.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We may update this Privacy Policy from time to time. Any changes will be posted on this page with an updated revision date. Continued use of our Services constitutes acceptance of the updated policy."
msgstr "Potremmo aggiornare la presente Informativa sulla privacy di tanto in tanto. Eventuali modifiche verranno pubblicate su questa pagina con una data di revisione aggiornata. L'uso continuato dei nostri Servizi costituisce l'accettazione della politica aggiornata."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Contact Us</strong>\n                                                <span>Have questions or concerns? We're here to help.</span>"
msgstr "<strong>Contattaci</strong>\n                                                <span>Hai domande o dubbi? Siamo qui per aiutarti.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Return Policy"
msgstr "Politica di ritorno"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "At Aveenix Express, your satisfaction matters. This Returns Policy explains how cancellations, returns, refunds, and exchanges work across different product types available on our platform."
msgstr "In Aveenix Express, la tua soddisfazione è importante. La presente Politica sui resi spiega come funzionano cancellazioni, resi, rimborsi e cambi per i diversi tipi di prodotti disponibili sulla nostra piattaforma."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Cancellations</strong><span>Pre- and post-shipment cancellation rules.</span>"
msgstr "<strong>Annullamenti di ordini</strong><span>Regole di cancellazione pre e post spedizione.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Pre-Shipment:</strong> orders may be cancelled before shipment. To cancel or change an order, please contact us within 12 hours of placing it."
msgstr "<strong>Pre-Spedizione:</strong> gli ordini possono essere annullati prima della spedizione. Per annullare o modificare un ordine, ti preghiamo di contattarci entro 12 ore dall'effettuazione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Post-Shipment:</strong> once an order has entered packaging or shipping, cancellations are no longer possible. You may instead request a return after delivery (subject to eligibility)."
msgstr "<strong>Post-Spedizione:</strong> una volta che l'ordine è stato imballato o spedito, gli annullamenti non sono più possibili. Puoi invece richiedere un reso dopo la consegna (soggetto a idoneità)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Eligibility for Returns</strong><span>Conditions and non-returnable items.</span>"
msgstr "<strong>Idoneità ai resi</strong><span>Condizioni e articoli non restituibili.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>General Conditions:</strong> return requests must be made within 15 days of delivery. Items must be unused, undamaged, and in original packaging. Proof of purchase is required."
msgstr "<strong>Condizioni Generali:</strong> le richieste di reso devono essere effettuate entro 15 giorni dalla consegna. Gli articoli devono essere inutilizzati, non danneggiati e nella confezione originale. È richiesta la prova d'acquisto."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Non-Returnable Items:</strong> digital products or downloads, personalized or custom-made items, perishable goods, and items marked \"Final Sale\" (where clearly stated)."
msgstr "<strong>Articoli non restituibili:</strong> prodotti digitali o download, articoli personalizzati o su misura, beni deperibili e articoli contrassegnati con \"Vendita finale\" (dove chiaramente indicato)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Returns by Product Type</strong><span>How returns differ per product type.</span>"
msgstr "<strong>Resi per tipologia di prodotto</strong><span>In che modo i resi differiscono in base al tipo di prodotto.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Affiliate Products:</strong> purchased on third-party websites. Returns and refunds must follow the affiliate seller's return policy. Aveenix does not process refunds for affiliate purchases; return instructions are provided by the affiliate seller directly."
msgstr "<strong>Prodotti affiliati:</strong> acquistati su siti web di terzi. Resi e rimborsi devono seguire la politica di restituzione del venditore affiliato. Aveenix non elabora rimborsi per gli acquisti di affiliazione; le istruzioni per la restituzione sono fornite direttamente dal venditore affiliato."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Dropshipping Products:</strong> fulfilled by third-party suppliers. To initiate a return, contact the seller via your Aveenix account; if unresolved, escalate to Aveenix Support. Refunds are issued after the supplier receives and inspects the item. Processing may take up to 15 days after return confirmation."
msgstr "<strong>Prodotti in dropshipping:</strong> adempiuti da fornitori terzi. Per avviare un reso, contatta il venditore tramite il tuo account Aveenix; se irrisolto, rivolgersi al supporto Aveenix. I rimborsi vengono emessi dopo che il fornitore ha ricevuto e ispezionato l'articolo. L'elaborazione può richiedere fino a 15 giorni dalla conferma del reso."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Aveenix-Branded Products:</strong> sold and fulfilled directly by Aveenix. Returns can be initiated through your Aveenix account or customer support. Refunds are processed within 15 days after inspection, to the original payment method or store credit."
msgstr "<strong>Prodotti a marchio Aveenix:</strong> venduto e gestito direttamente da Aveenix. I resi possono essere avviati tramite il tuo account Aveenix o l'assistenza clienti. I rimborsi vengono elaborati entro 15 giorni dall'ispezione, tramite il metodo di pagamento originale o il credito del negozio."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Multi-Vendor Products:</strong> fulfilled by independent third-party vendors. Each vendor may have its own return policy. Returns must be initiated through the vendor via your Aveenix account; Aveenix support is available if vendor resolution fails. Refunds are issued after vendor confirmation and inspection."
msgstr "<strong>Prodotti multivendor:</strong> adempiuti da fornitori terzi indipendenti. Ogni venditore può avere la propria politica di restituzione. I resi devono essere avviati tramite il venditore tramite il tuo account Aveenix; Il supporto Aveenix è disponibile se la risoluzione del fornitore fallisce. I rimborsi vengono emessi dopo la conferma e l'ispezione del fornitore."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Refund Process</strong><span>Review, timing, and refund method.</span>"
msgstr "<strong>Processo di rimborso</strong><span>Modalità di revisione, tempistica e rimborso.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Review &amp; Approval:</strong> return requests are reviewed before approval instructions are issued."
msgstr "<strong>Revisione e approvazione:</strong> le richieste di reso vengono esaminate prima che vengano emesse le istruzioni di approvazione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Processing Time:</strong> refunds are typically processed within 15 days of item inspection."
msgstr "<strong>Tempo di elaborazione:</strong> i rimborsi vengono generalmente elaborati entro 15 giorni dall'ispezione dell'articolo."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Refund Method:</strong> refunds are issued to the original payment method, or store credit (where applicable)."
msgstr "<strong>Metodo di rimborso:</strong> i rimborsi vengono emessi sul metodo di pagamento originale o sul credito del negozio (ove applicabile)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Costs</strong><span>Who pays for return shipping.</span>"
msgstr "<strong>Costi di spedizione</strong><span>Chi paga la spedizione di ritorno.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Customers are responsible for return shipping unless the item is defective, the wrong item was sent, or the error was caused by the seller or Aveenix."
msgstr "I clienti sono responsabili della spedizione di restituzione a meno che l'articolo non sia difettoso, sia stato inviato l'articolo sbagliato o l'errore sia stato causato dal venditore o da Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "In eligible cases, a prepaid return label may be provided."
msgstr "Nei casi idonei, può essere fornita un'etichetta di reso prepagata."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Defective or Incorrect Items</strong><span>What to do if your item is wrong.</span>"
msgstr "<strong>Articoli difettosi o errati</strong><span>Cosa fare se il tuo articolo è sbagliato.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "If you receive a defective or incorrect item, contact us immediately via your Aveenix account. We will arrange a replacement, or a full refund (including return shipping where applicable)."
msgstr "Se ricevi un articolo difettoso o errato, contattaci immediatamente tramite il tuo account Aveenix. Organizzeremo una sostituzione o un rimborso completo (compresa la spedizione di restituzione, ove applicabile)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Resolution depends on product type: affiliate products follow the affiliate seller's return process; dropshipping products are supplier-managed with Aveenix support; Aveenix-branded products are fully handled by Aveenix; multi-vendor products are vendor-managed with Aveenix escalation support."
msgstr "La risoluzione dipende dal tipo di prodotto: i prodotti affiliati seguono la procedura di restituzione del venditore affiliato; i prodotti in dropshipping sono gestiti dai fornitori con il supporto Aveenix; I prodotti a marchio Aveenix sono completamente gestiti da Aveenix; i prodotti multi-vendor sono gestiti dal fornitore con il supporto di escalation Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Exchanges</strong><span>How exchanges work.</span>"
msgstr "<strong>Scambi</strong><span>Come funzionano gli scambi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Exchanges are subject to product availability. Please contact us before returning any item. Do not ship items back without authorization. Exchange shipping costs may apply."
msgstr "I cambi sono soggetti alla disponibilità del prodotto. Vi preghiamo di contattarci prima di restituire qualsiasi articolo. Non rispedire gli articoli senza autorizzazione. Potrebbero essere applicati costi di spedizione per il cambio."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Exceptional Circumstances</strong><span>Incorrect address and delays.</span>"
msgstr "<strong>Circostanze eccezionali</strong><span>Indirizzo errato e ritardi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Incorrect Address:</strong> orders not delivered due to incorrect address details provided by the customer are not eligible for refund."
msgstr "<strong>Indirizzo errato:</strong> gli ordini non consegnati a causa di indirizzi errati forniti dal cliente non hanno diritto al rimborso."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Delays Beyond Control:</strong> delays caused by customs, carrier disruptions, or natural events are handled case-by-case. Refund requests may be submitted 15 days after the 45-day guaranteed delivery window."
msgstr "<strong>Ritardi fuori controllo:</strong> i ritardi causati da dogane, interruzioni del trasporto o eventi naturali vengono gestiti caso per caso. Le richieste di rimborso possono essere inviate 15 giorni dopo la finestra di consegna garantita di 45 giorni."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Security Policy"
msgstr "Politica di sicurezza"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "At Aveenix Express, protecting your personal information and transaction data is a top priority. We implement strong technical and organisational security measures to ensure a safe and secure shopping experience."
msgstr "In Aveenix Express, la protezione delle tue informazioni personali e dei dati delle transazioni è una priorità assoluta. Implementiamo forti misure di sicurezza tecniche e organizzative per garantire un'esperienza di acquisto sicura e protetta."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Encryption &amp; Secure Connections</strong><span>SSL/TLS encryption and HTTPS.</span>"
msgstr "<strong>Crittografia e connessioni sicure</strong><span>Crittografia SSL/TLS e HTTPS.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "All data transmitted between your browser and our servers is encrypted using Secure Socket Layer (SSL) / TLS encryption."
msgstr "Tutti i dati trasmessi tra il tuo browser e i nostri server vengono crittografati utilizzando la crittografia Secure Socket Layer (SSL) / TLS."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "This encryption ensures your personal and payment information remains unreadable to unauthorised third parties during transmission. Our website operates exclusively over HTTPS for secure communication."
msgstr "Questa crittografia garantisce che le tue informazioni personali e di pagamento rimangano illeggibili a terzi non autorizzati durante la trasmissione. Il nostro sito web funziona esclusivamente tramite HTTPS per una comunicazione sicura."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Verified Security Certificates</strong><span>Trusted certificate authorities and PCI-DSS.</span>"
msgstr "<strong>Certificati di sicurezza verificati</strong><span>Autorità di certificazione affidabili e PCI-DSS.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Our SSL certificates are issued by trusted certificate authorities. Payment transactions are handled only by PCI-DSS compliant providers, ensuring industry-standard security."
msgstr "I nostri certificati SSL sono emessi da autorità di certificazione affidabili. Le transazioni di pagamento sono gestite solo da fornitori conformi allo standard PCI-DSS, garantendo la sicurezza standard del settore."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Payment Security</strong><span>Accepted methods and card handling.</span>"
msgstr "<strong>Sicurezza dei pagamenti</strong><span>Metodi accettati e gestione delle carte.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix Express never stores your credit card details. All payments are securely processed by trusted third-party payment providers."
msgstr "Aveenix Express non memorizza mai i dettagli della tua carta di credito. Tutti i pagamenti vengono elaborati in modo sicuro da fornitori di servizi di pagamento terzi affidabili."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Accepted Payment Methods:</strong> PayPal, Stripe, major credit and debit cards (Visa, MasterCard, American Express, Discover), and internet banking and other supported electronic payment methods (where available)."
msgstr "<strong>Metodi di pagamento accettati:</strong> PayPal, Stripe, le principali carte di credito e debito (Visa, MasterCard, American Express, Discover) e servizi bancari via Internet e altri metodi di pagamento elettronici supportati (ove disponibili)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Payments via PayPal</strong><span>How PayPal payments work.</span>"
msgstr "<strong>Pagamenti tramite PayPal</strong><span>Come funzionano i pagamenti PayPal.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "When you select PayPal, you are redirected to PayPal's secure environment and payment details are entered directly on PayPal's platform. Aveenix never accesses or stores your card or bank information. You may pay using PayPal balance, credit card, debit card, or bank account (e-check)."
msgstr "Quando selezioni PayPal, verrai reindirizzato all'ambiente sicuro di PayPal e i dettagli di pagamento verranno inseriti direttamente sulla piattaforma PayPal. Aveenix non accede né memorizza mai i dati della tua carta o bancaria. Puoi pagare utilizzando il saldo PayPal, carta di credito, carta di debito o conto bancario (assegno elettronico)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "How it works: review your cart and proceed to checkout; select PayPal as your payment method; log in to PayPal or create an account; complete payment securely; you are redirected back to Aveenix with order confirmation."
msgstr "Come funziona: controlla il tuo carrello e procedi al checkout; seleziona PayPal come metodo di pagamento; accedi a PayPal o crea un account; completare il pagamento in modo sicuro; verrai reindirizzato ad Aveenix con la conferma dell'ordine."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Payments via Stripe</strong><span>How Stripe payments work.</span>"
msgstr "<strong>Pagamenti tramite Stripe</strong><span>Come funzionano i pagamenti Stripe.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Stripe provides secure, encrypted payment processing directly on our website. Card information is encrypted before transmission; payments are processed according to PCI-DSS Level 1 compliance; Aveenix does not store or process raw card data."
msgstr "Stripe fornisce un'elaborazione dei pagamenti sicura e crittografata direttamente sul nostro sito web. Le informazioni sulla carta vengono crittografate prima della trasmissione; i pagamenti vengono elaborati secondo la conformità PCI-DSS Livello 1; Aveenix non memorizza né elabora i dati grezzi delle carte."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "How it works: review your cart and proceed to checkout; select Stripe as your payment method; enter card details securely; payment is processed through Stripe; you receive instant order confirmation."
msgstr "Come funziona: controlla il tuo carrello e procedi al checkout; seleziona Stripe come metodo di pagamento; inserisci i dati della carta in modo sicuro; il pagamento viene elaborato tramite Stripe; riceverai una conferma immediata dell'ordine."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Fraud Prevention &amp; Monitoring</strong><span>How we detect suspicious activity.</span>"
msgstr "<strong>Prevenzione e monitoraggio delle frodi</strong><span>Come rileviamo attività sospette.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Transactions are monitored for suspicious activity. Orders may be reviewed or delayed for verification if unusual behaviour is detected. Accounts involved in fraudulent activity may be suspended or terminated."
msgstr "Le transazioni vengono monitorate per attività sospette. Gli ordini potrebbero essere esaminati o ritardati per la verifica se viene rilevato un comportamento insolito. Gli account coinvolti in attività fraudolente potrebbero essere sospesi o chiusi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Both PayPal and Stripe offer industry-leading fraud prevention, encrypted transactions, traceable payment records, and buyer and seller protection mechanisms. You can always review transaction status directly through your PayPal or Stripe account."
msgstr "Sia PayPal che Stripe offrono prevenzione antifrode leader del settore, transazioni crittografate, registrazioni di pagamento tracciabili e meccanismi di protezione di acquirenti e venditori. Puoi sempre verificare lo stato della transazione direttamente tramite il tuo account PayPal o Stripe."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Data Access &amp; Privacy</strong><span>Who can access customer data.</span>"
msgstr "<strong>Accesso ai dati e privacy</strong><span>Chi può accedere ai dati dei clienti.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Access to customer data is restricted to authorised personnel only, used strictly for order processing, support, and legal compliance, and governed by our Privacy Policy and Terms of Service."
msgstr "L'accesso ai dati dei clienti è limitato al solo personale autorizzato, utilizzato rigorosamente per l'elaborazione degli ordini, il supporto e la conformità legale e regolato dalla nostra Informativa sulla privacy e dai Termini di servizio."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Company Information</strong><span>Legal entity and payment options.</span>"
msgstr "<strong>Informazioni aziendali</strong><span>Persona giuridica e opzioni di pagamento.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Legal Entity:</strong> AVEENIX LTD. <strong>NZBN:</strong> 9429051284299. <strong>GST Number:</strong> 139-002-016. <strong>Incorporation Date:</strong> 27 April 2023."
msgstr "<strong>Persona giuridica:</strong> AVEENIX LTD. <strong>NZBN:</strong> 9429051284299. <strong>Numero GST:</strong> 139-002-016. <strong>Data di costituzione:</strong> 27 aprile 2023."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Payment Options:</strong> Credit Card · Internet Banking · PayPal · Stripe."
msgstr "<strong>Opzioni di pagamento:</strong> Carta di credito · Internet Banking · PayPal · Stripe."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Sellers Policy"
msgstr "Politica dei venditori"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Welcome to Aveenix Express. We provide sellers with a flexible platform to reach customers, manage products, and grow their online business with confidence. This guide outlines the steps to get started and the standards expected of all sellers on the Aveenix platform."
msgstr "Benvenuti su Aveenix Express. Forniamo ai venditori una piattaforma flessibile per raggiungere i clienti, gestire i prodotti e far crescere il proprio business online in tutta sicurezza. Questa guida delinea i passaggi per iniziare e gli standard attesi da tutti i venditori sulla piattaforma Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Create Your Seller Account</strong><span>Sign up and business information.</span>"
msgstr "<strong>Crea il tuo account venditore</strong><span>Registrazione e informazioni commerciali.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Sign Up:</strong> register for a seller account by visiting the Seller Registration page and completing the application form."
msgstr "<strong>Iscrizione:</strong> registrati per un account venditore visitando la pagina Registrazione venditore e completando il modulo di richiesta."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Business Information:</strong> you'll be asked to provide your business or trading name, contact details, and tax or registration information (where applicable). All seller applications are reviewed to ensure platform quality and compliance."
msgstr "<strong>Informazioni commerciali:</strong> ti verrà chiesto di fornire la ragione sociale o commerciale, i dettagli di contatto e le informazioni fiscali o di registrazione (ove applicabile). Tutte le applicazioni dei venditori vengono esaminate per garantire la qualità e la conformità della piattaforma."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Set Up Your Store</strong><span>Branding and business details.</span>"
msgstr "<strong>Configura il tuo negozio</strong><span>Marchio e dettagli aziendali.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Store Branding:</strong> choose a unique store name, upload your logo, and customise your store profile to reflect your brand."
msgstr "<strong>Marchio del negozio:</strong> scegli un nome di negozio univoco, carica il tuo logo e personalizza il profilo del tuo negozio per riflettere il tuo marchio."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Business Details:</strong> set up business hours, shipping information, returns and refund policy, and customer support contact details."
msgstr "<strong>Dettagli aziendali:</strong> impostare l'orario lavorativo, le informazioni sulla spedizione, la politica di restituzione e rimborso e i dettagli di contatto dell'assistenza clienti."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>List Your Products</strong><span>Listings and listing types.</span>"
msgstr "<strong>Elenca i tuoi prodotti</strong><span>Elenchi e tipologie di elenchi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Product Listings:</strong> create clear, accurate listings that include high-quality images, detailed product descriptions, correct pricing and availability, and variants (size, colour, etc.) where applicable."
msgstr "<strong>Elenchi di prodotti:</strong> creare elenchi chiari e accurati che includano immagini di alta qualità, descrizioni dettagliate dei prodotti, prezzi e disponibilità corretti e varianti (dimensioni, colore, ecc.) ove applicabile."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Listing Types:</strong> depending on the product category and seller setup, listings may include Buy Now (fixed-price products) and auction-style listings (where enabled)."
msgstr "<strong>Tipi di elenchi:</strong> a seconda della categoria del prodotto e della configurazione del venditore, le inserzioni possono includere Acquista adesso (prodotti a prezzo fisso) e inserzioni in stile asta (dove abilitato)."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping &amp; Extras:</strong> set shipping fees clearly, include handling times, and add optional promotions where supported."
msgstr "<strong>Spedizione ed extra:</strong> imposta chiaramente le tariffe di spedizione, includi i tempi di gestione e aggiungi promozioni facoltative ove supportato."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Manage Your Listings</strong><span>Seller dashboard and mobile access.</span>"
msgstr "<strong>Gestisci le tue inserzioni</strong><span>Dashboard del venditore e accesso mobile.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Seller Dashboard:</strong> use the Seller Dashboard to edit and update listings, track inventory, receive order notifications, and monitor performance."
msgstr "<strong>Dashboard del venditore:</strong> utilizza la dashboard del venditore per modificare e aggiornare le inserzioni, tenere traccia dell'inventario, ricevere notifiche sugli ordini e monitorare le prestazioni."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Mobile Access:</strong> where available, mobile tools allow you to manage your store on the go."
msgstr "<strong>Accesso mobile:</strong> ove disponibili, gli strumenti mobili ti consentono di gestire il tuo negozio in movimento."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Set Up Payments</strong><span>Payment integration and compliance.</span>"
msgstr "<strong>Imposta i pagamenti</strong><span>Integrazione e conformità dei pagamenti.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Payment Integration:</strong> configure supported payment methods, which may include credit and debit cards, PayPal, and other payment gateways supported by Aveenix."
msgstr "<strong>Integrazione dei pagamenti:</strong> configurare i metodi di pagamento supportati, che possono includere carte di credito e debito, PayPal e altri gateway di pagamento supportati da Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Security &amp; Compliance:</strong> all payment methods must comply with Aveenix's security standards and applicable regulations."
msgstr "<strong>Sicurezza e conformità:</strong> tutti i metodi di pagamento devono essere conformi agli standard di sicurezza di Aveenix e alle normative applicabili."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Configure Shipping &amp; Delivery</strong><span>Options and shipping policy.</span>"
msgstr "<strong>Configura spedizione e consegna</strong><span>Opzioni e politica di spedizione.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Options:</strong> define domestic and international shipping methods, delivery timeframes, and shipping rates."
msgstr "<strong>Opzioni di spedizione:</strong> definire metodi di spedizione nazionali e internazionali, tempi di consegna e tariffe di spedizione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Policy:</strong> clearly outline processing times, estimated delivery windows, and responsibility for shipping costs."
msgstr "<strong>Politica di spedizione:</strong> delineare chiaramente i tempi di elaborazione, le finestre di consegna stimate e la responsabilità per i costi di spedizione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Store Policies</strong><span>Returns, refunds, and privacy.</span>"
msgstr "<strong>Politiche del negozio</strong><span>Resi, rimborsi e privacy.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Returns &amp; Refunds:</strong> sellers must publish a return and refund policy that aligns with Aveenix guidelines and meets applicable consumer protection laws."
msgstr "<strong>Resi e rimborsi:</strong> i venditori devono pubblicare una politica di restituzione e rimborso che sia in linea con le linee guida Aveenix e rispetti le leggi applicabili sulla protezione dei consumatori."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Privacy Policy:</strong> explain how customer data is collected, used, and protected in line with Aveenix standards and legal requirements."
msgstr "<strong>Politica sulla riservatezza:</strong> spiegare come i dati dei clienti vengono raccolti, utilizzati e protetti in linea con gli standard Aveenix e i requisiti legali."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Management &amp; Customer Service</strong><span>Fulfilment and support.</span>"
msgstr "<strong>Gestione degli ordini e servizio clienti</strong><span>Realizzazione e supporto.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Fulfilment:</strong> process orders promptly, update order statuses accurately, and provide tracking information where applicable."
msgstr "<strong>Evasione dell'ordine:</strong> elaborare gli ordini tempestivamente, aggiornare accuratamente gli stati degli ordini e fornire informazioni di tracciabilità ove applicabile."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Customer Support:</strong> respond to customer enquiries professionally via Aveenix's messaging tools. Timely communication is essential to maintaining a strong seller reputation."
msgstr "<strong>Assistenza clienti:</strong> rispondere alle richieste dei clienti in modo professionale tramite gli strumenti di messaggistica di Aveenix. Una comunicazione tempestiva è essenziale per mantenere una forte reputazione del venditore."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Promote Your Store</strong><span>Marketing and advertising tools.</span>"
msgstr "<strong>Promuovi il tuo negozio</strong><span>Strumenti di marketing e pubblicità.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Marketing Tools:</strong> use Aveenix's built-in tools (where available) to run promotions, highlight products, and engage customers."
msgstr "<strong>Strumenti di marketing:</strong> utilizzare gli strumenti integrati di Aveenix (ove disponibili) per eseguire promozioni, evidenziare prodotti e coinvolgere i clienti."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Advertising Opportunities:</strong> optional advertising tools may be available to increase product visibility and reach."
msgstr "<strong>Opportunità pubblicitarie:</strong> potrebbero essere disponibili strumenti pubblicitari opzionali per aumentare la visibilità e la portata del prodotto."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Monitor &amp; Improve Performance</strong><span>Analytics, feedback, and reviews.</span>"
msgstr "<strong>Monitorare e migliorare le prestazioni</strong><span>Analisi, feedback e recensioni.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Analytics &amp; Insights:</strong> track sales performance, customer behaviour, and conversion trends."
msgstr "<strong>Analisi e approfondimenti:</strong> monitorare le prestazioni delle vendite, il comportamento dei clienti e le tendenze di conversione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Feedback &amp; Reviews:</strong> customer reviews help build trust. Use feedback to improve listings, service quality, and fulfilment processes."
msgstr "<strong>Feedback e recensioni:</strong> le recensioni dei clienti aiutano a creare fiducia. Utilizza il feedback per migliorare le inserzioni, la qualità del servizio e i processi di evasione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Stay Compliant</strong><span>Legal and platform compliance.</span>"
msgstr "<strong>Rimani conforme</strong><span>Conformità legale e della piattaforma.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Sellers must comply with all applicable e-commerce, tax, and consumer laws, and follow Aveenix's platform rules and best practices. Failure to comply may result in account restrictions or removal from the platform."
msgstr "I venditori devono rispettare tutte le leggi applicabili in materia di commercio elettronico, tasse e tutela dei consumatori e seguire le regole e le migliori pratiche della piattaforma Aveenix. La mancata osservanza può comportare restrizioni dell'account o rimozione dalla piattaforma."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Shipping Policy"
msgstr "Politica di spedizione"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix Express partners with a range of suppliers and sellers worldwide. Shipping options, delivery times, and costs vary depending on the product type and shipping origin."
msgstr "Aveenix Express collabora con una vasta gamma di fornitori e venditori in tutto il mondo. Le opzioni di spedizione, i tempi di consegna e i costi variano a seconda del tipo di prodotto e dell'origine della spedizione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping &amp; Delivery Overview</strong><span>What this policy covers.</span>"
msgstr "<strong>Panoramica su spedizione e consegna</strong><span>Cosa copre questa polizza.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "This policy explains how shipping works for Affiliate Products, Dropshipping Products, Aveenix-Branded Products, and Multivendor Products."
msgstr "Questa politica spiega come funziona la spedizione per i prodotti affiliati, i prodotti in dropshipping, i prodotti a marchio Aveenix e i prodotti multivendor."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Methods &amp; Delivery Times</strong><span>Times by product type.</span>"
msgstr "<strong>Metodi di spedizione e tempi di consegna</strong><span>Tempi per tipologia di prodotto.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Affiliate Products:</strong> sold and fulfilled by third-party retailers (such as Amazon). Shipping methods, delivery times, costs, and tracking are determined and provided by the affiliate seller. All shipping, delivery, and returns are subject to the affiliate seller's policies."
msgstr "<strong>Prodotti affiliati:</strong> venduti e gestiti da rivenditori terzi (come Amazon). I metodi di spedizione, i tempi di consegna, i costi e il monitoraggio sono determinati e forniti dal venditore affiliato. Tutte le spedizioni, consegne e resi sono soggetti alle politiche del venditore affiliato."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Dropshipping Products:</strong> free shipping on select products (depending on supplier); standard shipping estimated 10–15 business days; expedited shipping estimated 5–10 business days (additional charges may apply); international shipping available to most countries. Times may vary by supplier location, customs processing, and destination."
msgstr "<strong>Prodotti in dropshipping:</strong> spedizione gratuita su prodotti selezionati (a seconda del fornitore); spedizione standard stimata in 10-15 giorni lavorativi; spedizione rapida stimata in 5-10 giorni lavorativi (potrebbero essere applicati costi aggiuntivi); spedizione internazionale disponibile per la maggior parte dei paesi. I tempi possono variare in base alla sede del fornitore, alle procedure doganali e alla destinazione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Aveenix-Branded Products:</strong> free shipping on select products or promotions; standard shipping estimated 5–7 business days; expedited shipping estimated 2–3 business days (additional charges apply); international shipping available to selected regions. Exact times and costs shown at checkout."
msgstr "<strong>Prodotti a marchio Aveenix:</strong> spedizione gratuita su prodotti o promozioni selezionati; spedizione standard stimata in 5-7 giorni lavorativi; spedizione rapida stimata in 2-3 giorni lavorativi (si applicano costi aggiuntivi); spedizione internazionale disponibile per regioni selezionate. Tempi e costi esatti indicati al momento del pagamento."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Multivendor Products:</strong> shipping methods set by each individual vendor; standard shipping estimated 7–14 business days; expedited shipping where supported by the vendor (additional charges may apply); international shipping availability depends on the vendor."
msgstr "<strong>Prodotti multivendor:</strong> metodi di spedizione stabiliti da ogni singolo venditore; spedizione standard stimata in 7-14 giorni lavorativi; spedizione rapida ove supportata dal venditore (potrebbero essere applicati costi aggiuntivi); la disponibilità della spedizione internazionale dipende dal venditore."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Processing Time</strong><span>How long before orders ship.</span>"
msgstr "<strong>Tempo di elaborazione dell'ordine</strong><span>Quanto tempo prima della spedizione degli ordini.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Orders are typically processed within 1–2 business days. During peak periods, processing may take up to 3 business days."
msgstr "Gli ordini vengono generalmente elaborati entro 1-2 giorni lavorativi. Durante i periodi di punta, l'elaborazione può richiedere fino a 3 giorni lavorativi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Processing times vary by product type: affiliate products managed by the affiliate retailer; dropshipping products processed by the supplier; branded products processed by Aveenix; multivendor products processed by the individual seller. Once your order ships, you'll receive confirmation with tracking details where available."
msgstr "I tempi di elaborazione variano in base al tipo di prodotto: prodotti affiliati gestiti dal rivenditore affiliato; prodotti in dropshipping trattati dal fornitore; prodotti di marca elaborati da Aveenix; prodotti multivendor elaborati dal singolo venditore. Una volta spedito l'ordine, riceverai una conferma con i dettagli di tracciamento, ove disponibili."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Order Tracking</strong><span>Where to view tracking.</span>"
msgstr "<strong>Tracciamento ordine</strong><span>Dove visualizzare il monitoraggio.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Tracking details are provided once an order is shipped. Tracking availability depends on the product type and carrier. You can view tracking updates via your Aveenix account (where applicable) or the seller or supplier's tracking link."
msgstr "I dettagli di tracciamento vengono forniti una volta spedito l'ordine. La disponibilità del monitoraggio dipende dal tipo di prodotto e dal corriere. Puoi visualizzare gli aggiornamenti di tracciamento tramite il tuo account Aveenix (ove applicabile) o il link di tracciamento del venditore o fornitore."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Rates</strong><span>How costs are calculated.</span>"
msgstr "<strong>Tariffe di spedizione</strong><span>Come vengono calcolati i costi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Shipping costs are calculated based on product type, weight and size, shipping destination, and selected shipping method. Any applicable shipping charges are displayed before checkout. Free shipping may apply to select products or promotions."
msgstr "I costi di spedizione vengono calcolati in base al tipo di prodotto, al peso e alle dimensioni, alla destinazione della spedizione e al metodo di spedizione selezionato. Eventuali spese di spedizione applicabili vengono visualizzate prima del pagamento. La spedizione gratuita potrebbe essere applicata a prodotti o promozioni selezionati."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>International Shipping &amp; Customs</strong><span>Duties and import fees.</span>"
msgstr "<strong>Spedizioni internazionali e dogana</strong><span>Dazi e tasse di importazione.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "For international orders, customs duties, taxes, and import fees may apply. These charges are not included in the product or shipping price. The recipient is responsible for any customs fees imposed by their country. By placing an international order, you acknowledge and accept potential customs charges."
msgstr "Per gli ordini internazionali potrebbero essere applicati dazi doganali, tasse e tasse di importazione. Queste spese non sono incluse nel prezzo del prodotto o della spedizione. Il destinatario è responsabile di eventuali tasse doganali imposte dal proprio paese. Effettuando un ordine internazionale, riconosci e accetti potenziali oneri doganali."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Shipping Restrictions</strong><span>Where we can and can't ship.</span>"
msgstr "<strong>Restrizioni di spedizione</strong><span>Dove possiamo e non possiamo spedire.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "We ship to many international destinations, but some locations may be restricted. Certain suppliers or vendors may not ship to specific countries. If shipping is unavailable to your location, you'll be notified before checkout or contacted directly."
msgstr "Spediamo in molte destinazioni internazionali, ma alcune località potrebbero essere limitate. Alcuni fornitori o venditori potrebbero non effettuare spedizioni in paesi specifici. Se la spedizione non è disponibile per la tua posizione, verrai avvisato prima del pagamento o contattato direttamente."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix Cashback Program"
msgstr "Programma di rimborso Aveenix"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Welcome to Aveenix. By participating in the Cashback Program, you agree to the terms outlined below. Please read them carefully."
msgstr "Benvenuti ad Aveenix. Partecipando al Programma Cashback, accetti i termini descritti di seguito. Si prega di leggerli attentamente."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Aveenix Cashback Program</strong><span>How the program rewards you.</span>"
msgstr "<strong>Programma di rimborso Aveenix</strong><span>Come ti premia il programma.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "The Aveenix Cashback Program rewards eligible customers by sharing a portion of commissions earned on qualifying purchases. This policy explains how cashback is earned, tracked, and managed on the Aveenix platform."
msgstr "Il programma Aveenix Cashback premia i clienti idonei condividendo una parte delle commissioni guadagnate sugli acquisti idonei. Questa politica spiega come viene guadagnato, tracciato e gestito il cashback sulla piattaforma Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Eligibility</strong><span>Who can participate.</span>"
msgstr "<strong>Idoneità</strong><span>Chi può partecipare.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "To participate you must be a registered Aveenix user, logged in at the time of purchase or tracked click (where applicable), and your account must be in good standing. Cashback is not available to accounts involved in fraudulent, abusive, or manipulative activity. Cashback is not guaranteed and is awarded only when qualifying conditions are met."
msgstr "Per partecipare devi essere un utente Aveenix registrato, aver effettuato l'accesso al momento dell'acquisto o del clic tracciato (ove applicabile) e il tuo account deve essere in regola. Il cashback non è disponibile per i conti coinvolti in attività fraudolente, abusive o manipolative. Il cashback non è garantito e viene assegnato solo quando vengono soddisfatte le condizioni qualificanti."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Qualifying Purchases</strong><span>When a purchase qualifies.</span>"
msgstr "<strong>Acquisti idonei</strong><span>Quando un acquisto è idoneo.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "A purchase qualifies for cashback only if the purchase results in a successful and verified sale, the order is not cancelled, returned, or refunded, and the transaction is completed through a valid Aveenix tracking mechanism. Cashback eligibility may vary by product, supplier, or promotion and will be determined at Aveenix's discretion."
msgstr "Un acquisto è idoneo al rimborso solo se l'acquisto si traduce in una vendita verificata e andata a buon fine, l'ordine non viene annullato, restituito o rimborsato e la transazione viene completata tramite un meccanismo di tracciamento Aveenix valido. L'idoneità al rimborso può variare in base al prodotto, al fornitore o alla promozione e sarà determinata a discrezione di Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Product Type Eligibility</strong><span>Affiliate, branded, exclusions.</span>"
msgstr "<strong>Idoneità al tipo di prodotto</strong><span>Affiliazione, marchio, esclusioni.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Affiliate Products:</strong> cashback may apply to purchases made through Aveenix affiliate links, funded from a portion of the commission Aveenix receives, and issued only after the affiliate provider confirms the commission."
msgstr "<strong>Prodotti affiliati:</strong> il cashback può applicarsi agli acquisti effettuati tramite i link di affiliazione Aveenix, finanziati da una parte della commissione che Aveenix riceve ed emesso solo dopo che il fornitore affiliato ha confermato la commissione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Aveenix-Sold Products (Branded / Dropship):</strong> cashback may apply where explicitly stated, calculated only after payment is confirmed and return periods have passed."
msgstr "<strong>Prodotti venduti da Aveenix (di marca/Dropship):</strong> il cashback può applicarsi dove esplicitamente indicato, calcolato solo dopo la conferma del pagamento e dopo che i periodi di restituzione sono trascorsi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Exclusions:</strong> gift cards, coupons, or heavily discounted promotional items may be excluded. Certain brands or suppliers may restrict cashback eligibility."
msgstr "<strong>Esclusioni:</strong> possono essere esclusi buoni regalo, coupon o articoli promozionali fortemente scontati. Alcuni marchi o fornitori potrebbero limitare l'idoneità al rimborso."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Cashback Calculation</strong><span>How amounts are worked out.</span>"
msgstr "<strong>Calcolo del rimborso</strong><span>Come vengono calcolati gli importi.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Cashback amounts are calculated based on a percentage of commission earned, not the product price. The cashback rate may vary depending on retailer or supplier, product category, and promotional terms in effect at the time of purchase."
msgstr "Gli importi del cashback vengono calcolati in base a una percentuale della commissione guadagnata, non al prezzo del prodotto. Il tasso di rimborso può variare a seconda del rivenditore o del fornitore, della categoria del prodotto e dei termini promozionali in vigore al momento dell'acquisto."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix reserves the right to adjust cashback rates at any time. Current rates, where applicable, will be shown on the website or user dashboard."
msgstr "Aveenix si riserva il diritto di modificare le tariffe di cashback in qualsiasi momento. Le tariffe attuali, ove applicabili, verranno visualizzate sul sito Web o sulla dashboard dell'utente."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Cashback Verification &amp; Processing</strong><span>Pending status and timing.</span>"
msgstr "<strong>Verifica ed elaborazione del cashback</strong><span>Stato e tempistica in sospeso.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Cashback enters a pending status after a qualifying transaction. Verification typically occurs within 30–60 days, depending on affiliate confirmation and refund and return windows. If a transaction is reversed or rejected, associated cashback will be cancelled."
msgstr "Il cashback entra in uno stato in sospeso dopo una transazione qualificante. La verifica avviene in genere entro 30-60 giorni, a seconda della conferma dell'affiliato e delle finestre di rimborso e restituzione. Se una transazione viene annullata o rifiutata, il cashback associato verrà annullato."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Cashback Balance &amp; Use</strong><span>Go-live scope at launch.</span>"
msgstr "<strong>Saldo e utilizzo del cashback</strong><span>Ambito di go-live al momento del lancio.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "At launch, cashback is credited to your Aveenix rewards balance. Cashback is not redeemable at checkout, cannot be withdrawn as cash, and has no cash value outside the Aveenix platform."
msgstr "Al momento del lancio, il cashback viene accreditato sul saldo dei premi Aveenix. Il cashback non è riscattabile alla cassa, non può essere ritirato come contanti e non ha valore in contanti al di fuori della piattaforma Aveenix."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Future redemption or withdrawal features may be introduced later and will be governed by updated terms."
msgstr "Le future funzionalità di riscatto o prelievo potrebbero essere introdotte in seguito e saranno regolate da termini aggiornati."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Adjustments, Reversals &amp; Errors</strong><span>When cashback changes.</span>"
msgstr "<strong>Aggiustamenti, inversioni ed errori</strong><span>Quando cambia il cashback.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix reserves the right to adjust cashback balances for cancelled, refunded, or disputed transactions, reverse cashback awarded in error, and decline cashback where tracking data is incomplete or invalid. Any cashback discrepancies must be reported within 30 days of the transaction date."
msgstr "Aveenix si riserva il diritto di modificare i saldi del cashback per transazioni annullate, rimborsate o contestate, di annullare il cashback concesso per errore e di rifiutare il cashback laddove i dati di tracciamento sono incompleti o non validi. Eventuali discrepanze relative al cashback devono essere segnalate entro 30 giorni dalla data della transazione."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Fraud &amp; Abuse</strong><span>What leads to forfeiture.</span>"
msgstr "<strong>Frode e abusi</strong><span>Ciò che porta alla decadenza.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Accounts may be suspended or terminated if involved in false or self-generated transactions, multiple account abuse, manipulation of tracking systems, or breach of affiliate or platform terms. In such cases, all cashback balances may be forfeited."
msgstr "Gli account possono essere sospesi o chiusi se coinvolti in transazioni false o autogenerate, abuso di account multipli, manipolazione di sistemi di tracciamento o violazione dei termini di affiliazione o della piattaforma. In questi casi, tutti i saldi del cashback potrebbero essere persi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Program Changes</strong><span>How changes are communicated.</span>"
msgstr "<strong>Modifiche al programma</strong><span>Come vengono comunicati i cambiamenti.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "Aveenix may modify, suspend, or terminate the Cashback Program at any time. Where reasonably possible, material changes will be communicated via website updates, account notifications, and email notices. Continued use of the platform constitutes acceptance of updated terms."
msgstr "Aveenix può modificare, sospendere o terminare il Programma Cashback in qualsiasi momento. Ove ragionevolmente possibile, le modifiche sostanziali verranno comunicate tramite aggiornamenti del sito Web, notifiche sull'account e avvisi via e-mail. L'uso continuato della piattaforma implica l'accettazione dei termini aggiornati."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>Responsibility &amp; Account Management</strong><span>Your responsibilities.</span>"
msgstr "<strong>Responsabilità e gestione del conto</strong><span>Le tue responsabilità.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "You are responsible for maintaining accurate account information, monitoring your cashback balance, and ensuring compliance with this policy. Failure to report issues within the stated timeframe may result in forfeiture of claims."
msgstr "Sei responsabile del mantenimento di informazioni accurate sull'account, del monitoraggio del saldo del cashback e della conformità con questa politica. La mancata segnalazione dei problemi entro il termine indicato può comportare la decadenza dei reclami."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.privacy_policy_page
msgid "<strong>We're committed to transparency</strong>\n                                        <span>If you have any questions about this Privacy Policy or how we handle your data, please don't hesitate to get in touch with us.</span>"
msgstr "<strong>Ci impegniamo per la trasparenza</strong>\n                                        <span>Se hai domande sulla presente Informativa sulla privacy o su come gestiamo i tuoi dati, non esitare a contattarci.</span>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_shop_hero
#: model_terms:ir.ui.view,arch_db:aveenix_website.aveenix_header
msgid "Shop"
msgstr "Negozio"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_shop_hero
msgid "Browse our full product catalog. Filter by category, brand, and price to find exactly what you need."
msgstr "Sfoglia l’intero catalogo. Filtra per categoria, marca e prezzo per trovare esattamente ciò che cerchi."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "Aveenix Express Terms &amp; Conditions: User Agreement &amp; Legal Details"
msgstr "Termini e condizioni Aveenix Express: accordo con l'utente e dettagli legali"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "Read our Terms and Conditions for user agreement, privacy terms, and legal details. Understand our e-commerce policies, site usage, and purchase terms."
msgstr "Leggi i nostri Termini e condizioni per l'accordo con l'utente, i termini sulla privacy e i dettagli legali. Comprendere le nostre politiche di e-commerce, l'utilizzo del sito e i termini di acquisto."

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "Terms and Conditions, User Agreement, Privacy Terms, Website Terms, E-commerce Terms, Legal Terms, Usage Policy, Purchase Terms, Site Policies"
msgstr "Termini e condizioni, Accordo per gli utenti, Termini sulla privacy, Termini del sito web, Termini dell'e-commerce, Termini legali, Politica di utilizzo, Termini di acquisto, Politiche del sito"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<span>Terms &amp; Conditions</span>\n                                <i class=\"fa fa-minus av-privacy-sidebar-icon\"/>"
msgstr "<span>Termini e condizioni</span>\n                                <i class=\"fa fa-minus av-privacy-sidebar-icon\"/>"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-info-circle\"/> Introduction"
msgstr "<i class=\"fa fa-info-circle\"/> Introduzione"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-check\"/>        Use of Services"
msgstr "<i class=\"fa fa-check\"/>        Utilizzo dei Servizi"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-user-circle\"/>  Accounts &amp; Registration"
msgstr "<i class=\"fa fa-user-circle\"/>  Conti e registrazione"

