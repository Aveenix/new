msgid "<span>Terms &amp; Conditions</span>\n                                <i class=\"fa fa-minus av-privacy-sidebar-icon\"/>"
msgstr "<span>Términos y condiciones</span>\n                                <i class=\"fa fa-minus av-privacy-sidebar-icon\"/>"

