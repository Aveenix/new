msgstr "<i class=\"fa fa-check\"/>        Uso de servicios"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-user-circle\"/>  Accounts &amp; Registration"
msgstr "<i class=\"fa fa-user-circle\"/>  Cuentas y registro"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-cubes\"/>       Products &amp; Transactions"
msgstr "<i class=\"fa fa-cubes\"/>       Productos y transacciones"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-credit-card\"/> Payments &amp; Fees"
msgstr "<i class=\"fa fa-credit-card\"/> Pagos y tarifas"

#. module: aveenix_website
#: model_terms:ir.ui.view,arch_db:aveenix_website.av_terms_hero
msgid "<i class=\"fa fa-undo\"/>        Returns, Refunds &amp; Shipping"
