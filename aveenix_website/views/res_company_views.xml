<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the custom Pinterest link next to the native social media fields
         on the company form (Settings → Companies → Social Media). -->
    <record id="view_company_form_aveenix_pinterest" model="ir.ui.view">
        <field name="name">res.company.form.aveenix.pinterest</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="social_media.view_company_form_inherit_social_media"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='social_tiktok']" position="after">
                <field name="social_pinterest"/>
                <field name="social_whatsapp" placeholder="https://wa.me/1234567890"/>
            </xpath>
        </field>
    </record>

</odoo>
