<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show affiliate URL inside the Aveenix Rewards tab (from aveenix_rewards). -->
    <record id="view_product_template_affiliate_rewards_tab" model="ir.ui.view">
        <field name="name">product.template.affiliate.rewards.tab</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="aveenix_rewards.view_product_template_rewards_tab"/>
        <field name="arch" type="xml">
            <field name="reward_pool_perc" position="after">
                <field name="affiliate_url"
                       invisible="aveenix_product_type != 'affiliate'"
                       widget="url"
                       placeholder="https://retailer.com/product/..."/>
                <field name="external_image_urls"
                       placeholder="https://cdn.example.com/img1.jpg, https://...jpg"/>
                <div invisible="not external_image_urls">
                    <field name="external_image_fetch_state" readonly="1"/>
                    <button type="object" name="action_fetch_external_image_now"
                            string="Download Image Now" class="btn-link"
                            icon="fa-download"/>
                </div>
                <field name="external_image_preview"
                       invisible="not external_image_urls"/>
            </field>
        </field>
    </record>

    <!-- Affiliate clicks smart button on the product form. -->
    <record id="view_product_template_affiliate_form" model="ir.ui.view">
        <field name="name">product.template.affiliate.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action"
                        name="%(action_affiliate_click_log)d"
                        class="oe_stat_button" icon="fa-mouse-pointer"
                        invisible="aveenix_product_type != 'affiliate'"
                        context="{'search_default_product_id': id, 'default_product_id': id}">
                    <field name="affiliate_click_count" widget="statinfo" string="Aff. Clicks"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="ai_description" string="AI Description">
                    <button type="object" name="action_generate_ai_content" string="Generate AI Description" class="btn-primary mb-2" icon="fa-magic"/>
                    <field name="desc_ai" nolabel="1" placeholder="AI generated description..."/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Server Action for mass AI generation -->
    <record id="action_mass_generate_ai_desc" model="ir.actions.server">
        <field name="name">Generate AI Descriptions</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                records.action_generate_ai_content()
        </field>
    </record>

</odoo>
