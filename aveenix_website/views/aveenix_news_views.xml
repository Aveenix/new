<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- News Article List (Tree) View -->
    <record id="view_aveenix_news_list" model="ir.ui.view">
        <field name="name">aveenix.news.list</field>
        <field name="model">aveenix.news</field>
        <field name="arch" type="xml">
            <list string="News Articles">
                <field name="published_date" widget="datetime"/>
                <field name="title"/>
                <field name="category"/>
                <field name="author"/>
                <field name="api_article_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- News Article Form View -->
    <record id="view_aveenix_news_form" model="ir.ui.view">
        <field name="name">aveenix.news.form</field>
        <field name="model">aveenix.news</field>
        <field name="arch" type="xml">
            <form string="News Article">
                <sheet>
                    <div class="oe_title">
                        <label for="title" class="oe_edit_only"/>
                        <h1>
                            <field name="title" placeholder="e.g. Expert Advice on Daily Makeup"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="author"/>
                            <field name="published_date"/>
                        </group>
                        <group>
                            <field name="image_url" widget="url"/>
                            <field name="source_url" widget="url"/>
                            <field name="api_article_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description_page">
                            <field name="description" placeholder="Enter a short summary..."/>
                        </page>
                        <page string="Content" name="content_page">
                            <field name="content" widget="html" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- News Article Search View -->
    <record id="view_aveenix_news_search" model="ir.ui.view">
        <field name="name">aveenix.news.search</field>
        <field name="model">aveenix.news</field>
        <field name="arch" type="xml">
            <search string="News Articles">
                <field name="title"/>
                <field name="author"/>
                <field name="category"/>
                <group>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category'}"/>
                    <filter string="Published Date" name="group_by_published_date" context="{'group_by': 'published_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- News Article Window Action -->
    <record id="action_aveenix_news" model="ir.actions.act_window">
        <field name="name">News Articles</field>
        <field name="res_model">aveenix.news</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_aveenix_news_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No news articles synced yet.
            </p>
            <p>
                Configure your NewsData.io API Key in Website Settings and run the news sync action.
            </p>
        </field>
    </record>

    <!-- Backend Menu Item under Website -> Site -->
    <menuitem id="menu_aveenix_news"
              name="News Articles"
              parent="website.menu_site"
              action="action_aveenix_news"
              sequence="30"
              groups="website.group_website_designer"/>

</odoo>
