<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blog_blog_form_inherit_aveenix" model="ir.ui.view">
        <field name="name">blog.blog.form.inherit.aveenix</field>
        <field name="model">blog.blog</field>
        <field name="inherit_id" ref="website_blog.view_blog_blog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_generate_ai_content" type="object" string="✨ Generate AI Description" class="btn-primary"/>
                </header>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Description">
                        <group>
                            <field name="tag_category_id"/>
                            <field name="av_blog_image" widget="image" options="{'size': [120, 120]}"/>
                        </group>
                        <field name="desc" widget="html"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
