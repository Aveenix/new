<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Footer: "Aveenix Connect" closes the "Explore Aveenix" list, after News
         and Freight. Appended to the end of the list (rather than after News)
         so it lands last whichever sister module's view is applied first. -->
    <template id="connect_footer_link" inherit_id="aveenix_website.aveenix_footer" name="Aveenix Connect: Footer Link">
        <xpath expr="//a[@href='/news']/../.." position="inside">
            <li><a href="/connect">Aveenix Connect</a></li>
        </xpath>
    </template>

    <!-- Header on /connect pages (is_connect_page and av_site_home, set by the
         controller): aveenix_header hides the Express word, shop search and
         shop nav; this adds the "Connect" word, the what + where search, the
         "List your business" action and the category nav. Server-side, so
         nothing flashes. -->
    <template id="connect_header" inherit_id="aveenix_website.aveenix_header" name="Aveenix Connect: Header">
