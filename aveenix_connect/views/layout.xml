                </g>
            </t>
        </xpath>

        <!-- Shop search → what + where directory search. -->
        <xpath expr="//form[hasclass('av-shop-search')]" position="after">
            <form t-if="is_connect_page" class="av-search-form avc-header-search" action="/connect/search" method="get">
                <input type="text" name="what" class="av-search-input" t-att-value="what or None"
                       placeholder="Search businesses, e.g. plumber, café…" aria-label="What are you looking for"/>
                <input type="text" name="where" class="av-search-input avc-header-where" t-att-value="where or None"
                       placeholder="City or postcode" aria-label="Where"/>
                <button type="submit" class="av-search-btn" aria-label="Search">
                    <i class="fa fa-search"/>
                </button>
            </form>
        </xpath>

        <xpath expr="//div[@id='top_menu']" position="inside">
            <div t-if="is_connect_page" class="av-connect-actions">
                <a t-if="not request.env.user._is_public()" href="/my/connect" class="av-header-action">
                    <i class="fa fa-building-o"/>
                    <span>My Listings</span>
                </a>
                <a href="/connect/add" class="av-connect-add-btn">List your business</a>
            </div>
        </xpath>

        <!-- Shop category nav → directory category nav. -->
        <xpath expr="//nav[hasclass('av-shop-nav')]" position="before">
            <nav class="av-cat-nav av-connect-nav" t-if="is_connect_page" aria-label="Connect">
                <div class="av-cat-nav-inner">
                    <ul class="av-cat-menu">
                        <li>
                            <a href="/connect" t-att-class="'active' if active_nav == 'home' else None">
                                <i class="fa fa-home"/><span>Home</span>
                            </a>
                        </li>
                        <li t-foreach="connect_nav_categories" t-as="nav_category">
                            <a t-attf-href="/connect/category/#{slug(nav_category)}"
                               t-att-class="'active' if active_nav == nav_category.id else None">
                                <i t-attf-class="fa #{nav_category.icon or 'fa-briefcase'}"/><span t-out="nav_category.name"/>
                            </a>
                        </li>
                        <li>
                            <a href="/connect/add" t-att-class="'active' if active_nav == 'add' else None">
                                <i class="fa fa-plus-circle"/><span>List your business</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </xpath>
    </template>
</odoo>
