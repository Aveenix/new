<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_connect" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.connect</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="after">
                <block title="Aveenix Connect: Google" name="aveenix_connect_google_block">
                    <setting string="Google Places API Key (server)"
                             help="Lets the Connect team find a listing's Google place from the backend. Enable Places API (New) on the key and restrict it to this server's IP address.">
                        <field name="connect_google_places_api_key" password="True"/>
                    </setting>
                    <setting string="Google Maps API Key (browser)"
                             help="Shows the map and Google's live rating, hours and photos on business pages. Enable Maps Embed API, Maps JavaScript API and Places API (New), and restrict the key to this website's address (HTTP referrers).">
                        <field name="connect_google_maps_api_key"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
