<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_nzbn_import_list" model="ir.ui.view">
        <field name="name">connect.nzbn.import.list</field>
        <field name="model">connect.nzbn.import</field>
        <field name="arch" type="xml">
            <list string="NZBN Bulk Imports">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="industry_code" optional="show"/>
                <field name="category_id"/>
                <field name="imported_count"/>
                <field name="total_items" optional="show"/>
                <field name="last_run" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'running'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_connect_nzbn_import_form" model="ir.ui.view">
        <field name="name">connect.nzbn.import.form</field>
        <field name="model">connect.nzbn.import</field>
        <field name="arch" type="xml">
            <form string="NZBN Bulk Import">
                <header>
                    <button name="action_run" type="object" string="Import Next Page" class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_restart" type="object" string="Start Over" invisible="state == 'running' and not next_page"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. plumbing"/>
                            <field name="industry_code" placeholder="e.g. E323110"/>
                            <field name="category_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="imported_count"/>
                            <field name="total_items"/>
                            <field name="next_page" string="Pages Done"/>
                            <field name="last_run"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        The scheduled action "Connect: NZBN import" imports one page (50 register entries) of the
                        import waiting longest every hour, publishing a listing for each registered business, and
                        refreshes the listings synced longest ago. Listings with an owner keep their own details.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_nzbn_import" model="ir.actions.act_window">
        <field name="name">NZBN Bulk Imports</field>
        <field name="res_model">connect.nzbn.import</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Fill the directory from the NZBN register</p>
            <p>Add a search term (e.g. "plumbing") and the category its businesses go in; the scheduled
               action then imports the matching registered businesses page by page.</p>
        </field>
    </record>

    <record id="action_connect_nzbn_search" model="ir.actions.act_window">
        <field name="name">Import from NZBN</field>
        <field name="res_model">connect.nzbn.search</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
