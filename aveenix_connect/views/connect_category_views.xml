<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connect_category_list" model="ir.ui.view">
        <field name="name">connect.category.list</field>
        <field name="model">connect.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="icon" optional="show"/>
                <field name="business_count"/>
            </list>
        </field>
    </record>

    <record id="view_connect_category_form" model="ir.ui.view">
        <field name="name">connect.category.form</field>
        <field name="model">connect.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Plumbers"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="business_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_connect_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">connect.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
