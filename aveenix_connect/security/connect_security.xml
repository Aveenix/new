<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_connect" model="ir.module.category">
        <field name="name">Connect</field>
        <field name="sequence">61</field>
    </record>

    <record id="res_groups_privilege_connect" model="res.groups.privilege">
        <field name="name">Connect</field>
        <field name="sequence">61</field>
        <field name="category_id" ref="module_category_connect"/>
    </record>

    <record id="group_connect_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_connect"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_connect_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_connect"/>
        <field name="implied_ids" eval="[(4, ref('group_connect_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Everyone reads published listings; the Connect team reads them all.
         Group rules add up, so a Connect user (also an internal user) gets
         both the published-only rule and the all-records one. -->
    <record id="rule_connect_business_published" model="ir.rule">
        <field name="name">Connect listings: published ones are public</field>
        <field name="model_id" ref="model_connect_business"/>
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_connect_business_team" model="ir.rule">
        <field name="name">Connect listings: the Connect team sees all</field>
        <field name="model_id" ref="model_connect_business"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_connect_user'))]"/>
    </record>
    <!-- Owners read and update their own listing, published or not; which
         fields they may change is enforced on connect.business.write. -->
    <record id="rule_connect_business_owner" model="ir.rule">
        <field name="name">Connect listings: owners manage their own</field>
        <field name="model_id" ref="model_connect_business"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Hours and photos follow their listing. -->
    <record id="rule_connect_hours_published" model="ir.rule">
        <field name="name">Connect hours: of published listings are public</field>
        <field name="model_id" ref="model_connect_business_hours"/>
        <field name="domain_force">[('business_id.is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_connect_hours_team" model="ir.rule">
        <field name="name">Connect hours: the Connect team sees all</field>
        <field name="model_id" ref="model_connect_business_hours"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_connect_user'))]"/>
    </record>
    <record id="rule_connect_hours_owner" model="ir.rule">
        <field name="name">Connect hours: owners manage their own</field>
        <field name="model_id" ref="model_connect_business_hours"/>
        <field name="domain_force">[('business_id.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_connect_image_published" model="ir.rule">
        <field name="name">Connect photos: of published listings are public</field>
        <field name="model_id" ref="model_connect_business_image"/>
        <field name="domain_force">[('business_id.is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal')), (4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_connect_image_team" model="ir.rule">
        <field name="name">Connect photos: the Connect team sees all</field>
        <field name="model_id" ref="model_connect_business_image"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_connect_user'))]"/>
    </record>
    <record id="rule_connect_image_owner" model="ir.rule">
        <field name="name">Connect photos: owners manage their own</field>
        <field name="model_id" ref="model_connect_business_image"/>
        <field name="domain_force">[('business_id.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
