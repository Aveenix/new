<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ── -->
    <record id="view_payment_gateway_config_form" model="ir.ui.view">
        <field name="name">aveenix.payment.gateway.config.form</field>
        <field name="model">aveenix.payment.gateway.config</field>
        <field name="arch" type="xml">
            <form string="Payment Gateway">
                <header>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-primary"
                            groups="aveenix_rewards.group_reward_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Stripe Live, PayPal Sandbox"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Credentials">
                            <field name="gateway"/>
                            <field name="mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="api_key"
                                   string="Client ID / Secret Key"
                                   placeholder="PayPal Client ID or Stripe sk_live_..."/>
                            <field name="api_secret"
                                   string="Client Secret"
                                   password="True"
                                   placeholder="PayPal only — leave blank for Stripe"
                                   invisible="gateway == 'stripe'"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"
                                   help="Auto-detected from Stripe on Test Connection. Manually select if needed."/>
                        </group>
                        <group string="Connection Status">
                            <field name="connection_status"
                                   widget="badge"
                                   decoration-success="connection_status == 'connected'"
                                   decoration-danger="connection_status == 'failed'"
                                   decoration-warning="connection_status == 'not_configured'"/>
                            <field name="connection_message" readonly="1"
                                   invisible="not connection_message"/>
                            <field name="last_tested" readonly="1"
                                   invisible="not last_tested"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ── -->
    <record id="view_payment_gateway_config_list" model="ir.ui.view">
        <field name="name">aveenix.payment.gateway.config.list</field>
        <field name="model">aveenix.payment.gateway.config</field>
        <field name="arch" type="xml">
            <list string="Payment Gateways"
                  decoration-success="connection_status == 'connected'"
                  decoration-danger="connection_status == 'failed'"
                  decoration-muted="connection_status == 'not_configured'">
                <field name="name"/>
                <field name="gateway"/>
                <field name="mode"
                       widget="badge"
                       decoration-success="mode == 'live'"
                       decoration-warning="mode == 'sandbox'"/>
                <field name="api_key" string="Client ID / Secret Key"/>
                <field name="connection_status"
                       widget="badge"
                       decoration-success="connection_status == 'connected'"
                       decoration-danger="connection_status == 'failed'"
                       decoration-warning="connection_status == 'not_configured'"/>
                <field name="connection_message" string="Last Test Result"/>
                <field name="last_tested"/>
                <button name="action_test_connection"
                        string="Test"
                        type="object"
                        icon="fa-plug"
                        groups="aveenix_rewards.group_reward_manager"/>
            </list>
        </field>
    </record>

    <!-- ── Action ── -->
    <record id="action_payment_gateway_config" model="ir.actions.act_window">
        <field name="name">Payment Gateways</field>
        <field name="res_model">aveenix.payment.gateway.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
