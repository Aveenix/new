<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_aveenix_rewards" model="ir.module.category">
        <field name="name">Aveenix Rewards</field>
        <field name="sequence">100</field>
    </record>

    <record id="privilege_aveenix_rewards" model="res.groups.privilege">
        <field name="name">Aveenix Rewards</field>
        <field name="category_id" ref="module_aveenix_rewards"/>
        <field name="sequence">100</field>
    </record>

    <record id="group_reward_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_aveenix_rewards"/>
    </record>

    <record id="group_reward_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_aveenix_rewards"/>
        <field name="implied_ids" eval="[(4, ref('group_reward_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
