<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wc_order_push_wizard_form" model="ir.ui.view">
        <field name="name">wc.order.push.wizard.form</field>
        <field name="model">wc.order.push.wizard</field>
        <field name="arch" type="xml">
            <form string="Push Order to WooCommerce">
                <group>
                    <field name="backend_id"/>
                    <field name="order_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_push" string="Push" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
