<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_freight" model="ir.module.category">
        <field name="name">Freight</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_freight" model="res.groups.privilege">
        <field name="name">Freight</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_freight"/>
    </record>

    <record id="group_freight_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_freight"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_freight_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_freight"/>
        <field name="implied_ids" eval="[(4, ref('group_freight_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Portal customers read their own company's quotes and shipments, and
         only the tracking events the team published to the tracker. -->
    <record id="rule_freight_quote_portal" model="ir.rule">
        <field name="name">Freight quotes: portal customers see their own</field>
        <field name="model_id" ref="model_freight_quote"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_freight_shipment_portal" model="ir.rule">
        <field name="name">Freight shipments: portal customers see their own</field>
        <field name="model_id" ref="model_freight_shipment"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_freight_event_portal" model="ir.rule">
        <field name="name">Freight tracking events: portal customers see their own public ones</field>
        <field name="model_id" ref="model_freight_shipment_event"/>
        <field name="domain_force">[('is_public', '=', True), ('shipment_id.partner_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
