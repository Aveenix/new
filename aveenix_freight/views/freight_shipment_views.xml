<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_shipment_list" model="ir.ui.view">
        <field name="name">freight.shipment.list</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="tracking_number"/>
                <field name="partner_id"/>
                <field name="mode"/>
                <field name="origin_port_id" string="From"/>
                <field name="destination_port_id" string="To"/>
                <field name="etd" optional="show"/>
                <field name="eta" optional="show"/>
                <field name="carrier" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="amount" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'booked')"
                       decoration-warning="state in ('picked_up', 'in_transit', 'arrived', 'customs', 'out_for_delivery')"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_freight_shipment_kanban" model="ir.ui.view">
        <field name="name">freight.shipment.kanban</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="mode" class="text-muted small"/>
                        </div>
                        <field name="partner_id"/>
                        <div class="text-muted small">
                            <field name="origin_port_id"/> → <field name="destination_port_id"/>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="small">ETA <field name="eta"/></span>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_freight_shipment_form" model="ir.ui.view">
        <field name="name">freight.shipment.form</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_book" type="object" string="Confirm Booking" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_pick_up" type="object" string="Picked Up" class="btn-primary"
                            invisible="state != 'booked'"/>
                    <button name="action_depart" type="object" string="Departed" class="btn-primary"
                            invisible="state not in ('booked', 'picked_up')"/>
                    <button name="action_arrive" type="object" string="Arrived" class="btn-primary"
                            invisible="state != 'in_transit'"/>
                    <button name="action_customs" type="object" string="In Customs"
                            invisible="state != 'arrived'"/>
                    <button name="action_out_for_delivery" type="object" string="Out for Delivery"
                            class="btn-primary" invisible="state not in ('arrived', 'customs')"/>
                    <button name="action_deliver" type="object" string="Delivered" class="btn-primary"
                            invisible="state not in ('arrived', 'customs', 'out_for_delivery')"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            invisible="state in ('draft', 'cancelled') or invoice_count"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('delivered', 'cancelled')"
                            confirm="Cancel this shipment? The customer's tracker will show it as cancelled."/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,booked,in_transit,arrived,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tracker" type="object" class="oe_stat_button"
                                icon="fa-map-marker" string="Website Tracker"/>
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not invoice_count">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <div class="text-muted">
                            Tracking <field name="tracking_number" class="fw-bold"/>
                        </div>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="quote_id" invisible="not quote_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Charges">
                            <label for="amount"/>
                            <div class="o_row">
                                <field name="amount"/>
                                <field name="currency_id" options="{'no_create': True}"/>
                            </div>
                            <field name="incoterm_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Route">
                            <field name="mode"/>
                            <field name="origin_address"/>
                            <field name="origin_port_id" options="{'no_create': True}"/>
                            <field name="destination_address"/>
                            <field name="destination_port_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="etd"/>
                            <field name="eta"/>
                            <field name="atd"/>
                            <field name="ata"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tracking" name="tracking">
                            <field name="event_ids">
                                <list editable="top">
                                    <field name="date"/>
                                    <field name="status"/>
                                    <field name="location"/>
                                    <field name="description"/>
                                    <field name="is_public" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Carriage" name="carriage">
                            <group>
                                <group>
                                    <field name="carrier"/>
                                    <field name="vessel_flight"/>
                                    <field name="bl_awb_number"/>
                                </group>
                                <group>
                                    <field name="container_type" invisible="mode != 'ocean_fcl'"/>
                                    <field name="container_qty" invisible="mode != 'ocean_fcl'"/>
                                    <field name="container_numbers" invisible="mode not in ('ocean_fcl', 'ocean_lcl')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Cargo" name="cargo">
                            <group>
                                <group>
                                    <field name="commodity"/>
                                    <field name="packages"/>
                                    <field name="weight_kg"/>
                                    <field name="volume_cbm"/>
                                </group>
                                <group>
                                    <field name="is_hazardous"/>
                                    <field name="needs_customs"/>
                                    <field name="needs_insurance"/>
                                </group>
                            </group>
                            <field name="cargo_description" placeholder="Cargo description and handling notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_freight_shipment_search" model="ir.ui.view">
        <field name="name">freight.shipment.search</field>
        <field name="model">freight.shipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('tracking_number', 'ilike', self), ('bl_awb_number', 'ilike', self), ('container_numbers', 'ilike', self)]"
                       string="Reference / Tracking / B/L / Container"/>
                <field name="partner_id"/>
                <field name="origin_port_id"/>
                <field name="destination_port_id"/>
                <filter name="my" string="My Shipments" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="active_shipments" string="Active"
                        domain="[('state', 'not in', ('delivered', 'cancelled'))]"/>
                <filter name="in_transit" string="In Transit" domain="[('state', '=', 'in_transit')]"/>
                <filter name="delivered" string="Delivered" domain="[('state', '=', 'delivered')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_mode" string="Mode" context="{'group_by': 'mode'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_freight_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">freight.shipment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_shipments': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shipments yet</p>
            <p>Book one from a quote request, or create it here. Every status change is
               published to the customer's tracker on /freight/track.</p>
        </field>
    </record>
</odoo>
