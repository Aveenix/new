<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Auto-Fetch Order Tracking & Status from CJ (every 2 hours) -->
        <record id="ir_cron_cj_fetch_tracking" model="ir.cron">
            <field name="name">CJ Dropshipping: Auto-Fetch Tracking Links &amp; Status</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_cj_tracking()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Auto-Push Confirmed Sale Orders to CJ Dropshipping (every 30 minutes) -->
        <record id="ir_cron_cj_push_orders" model="ir.cron">
            <field name="name">CJ Dropshipping: Auto-Push Confirmed Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_push_cj_orders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. Auto-Sync My Products from CJ Store Catalog (every 12 hours) -->
        <record id="ir_cron_cj_sync_my_products" model="ir.cron">
            <field name="name">CJ Dropshipping: Auto-Sync My Products Catalog</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_cj_my_products()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 4. Auto-Refresh CJ Access Token (every 7 days) -->
        <record id="ir_cron_cj_refresh_token" model="ir.cron">
            <field name="name">CJ Dropshipping: Auto-Refresh Access Token</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_cj_token()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
