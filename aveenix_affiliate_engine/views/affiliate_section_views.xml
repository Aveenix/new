<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_affiliate_section_list" model="ir.ui.view">
        <field name="name">affiliate.section.list</field>
        <field name="model">affiliate.section</field>
        <field name="arch" type="xml">
            <list string="Affiliate Sections" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="offer_count" string="Offers"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_affiliate_section_search" model="ir.ui.view">
        <field name="name">affiliate.section.search</field>
        <field name="model">affiliate.section</field>
        <field name="arch" type="xml">
            <search string="Affiliate Sections">
                <field name="name"/>
                <filter name="enabled" string="Allowing Offers" domain="[('active','=',True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_affiliate_section" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">affiliate.section</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_affiliate_section_search"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sections configured.</p>
            <p>
                Each row is an Aveenix News category. Switch one off to stop
                placing affiliate offers in its articles — existing placements
                there stop showing straight away.
            </p>
        </field>
    </record>

</odoo>
