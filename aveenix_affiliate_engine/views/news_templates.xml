<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── The recommendation card ──────────────────────────────────────
         One template for both slots, called with `placement` set. The outbound
         href is ALWAYS /aveenix/affiliate/offer/<id> and never the network URL:
         the real link is resolved server-side at click time, so it is never in
         the page source, never scraped, and never reachable without a click
         being logged first.

         rel="sponsored nofollow noopener" is not decoration — search engines
         require paid links to declare themselves, and noopener keeps the
         merchant page away from window.opener. -->
    <template id="affiliate_offer_card" name="Aveenix Affiliate Offer Card">
        <div class="av-affiliate-offer card my-4 shadow-sm"
             style="border: 1px solid rgba(0,0,0,.125); border-radius: 10px; overflow: hidden;">
            <div class="row g-0 align-items-center">
                <t t-if="placement.offer_id.image_url">
                    <div class="col-4 col-md-3">
                        <img t-att-src="placement.offer_id.image_url"
                             class="img-fluid w-100"
                             style="object-fit: contain; max-height: 160px; background: #fff;"
                             loading="lazy" t-att-alt="placement.offer_id.name"/>
                    </div>
                </t>
                <div t-attf-class="#{placement.offer_id.image_url and 'col-8 col-md-9' or 'col-12'}">
                    <div class="card-body">
                        <div class="text-uppercase fw-bold mb-1"
                             style="font-size: .6875rem; letter-spacing: .06em; color: var(--av-red, #dc3545);">
                            Recommended
                        </div>
                        <h5 class="card-title mb-1" style="font-weight: 700;">
                            <t t-esc="placement.offer_id.name"/>
                        </h5>
                        <t t-if="placement.offer_id.advertiser_id">
                            <div class="text-muted mb-2" style="font-size: .8125rem;">
                                from <t t-esc="placement.offer_id.advertiser_id.name"/>
                            </div>
                        </t>
                        <t t-if="placement.offer_id.description">
                            <p class="card-text text-muted mb-2" style="font-size: .9375rem;">
                                <t t-esc="placement.offer_id.description[:220]"/>
                            </p>
                        </t>
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <a t-attf-href="/aveenix/affiliate/offer/#{placement.id}"
                               target="_blank"
                               rel="sponsored nofollow noopener"
                               class="btn btn-sm text-white"
                               style="background: var(--av-red, #dc3545);">
                                View Offer
                            </a>
                            <t t-if="placement.offer_id.price">
                                <span class="fw-bold">
                                    <t t-out="placement.offer_id.currency_id.symbol or ''"/><t
                                        t-esc="'%.2f' % placement.offer_id.price"/>
                                </span>
                            </t>
                        </div>
                        <div class="text-muted mt-2" style="font-size: .75rem;">
                            <t t-esc="av_affiliate_disclosure"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- ── In-article placement ─────────────────────────────────────────
         The body is re-rendered from two halves split at a paragraph boundary
         (aveenix.news._av_split_content), so the card sits BETWEEN paragraphs
         rather than after the article. The stored article HTML is untouched:
         the split happens per request, which is why re-syncing an article from
         NewsData.io cannot clobber a placement and why uninstalling this module
         leaves every article exactly as it was. -->
    <record id="news_detail_affiliate" model="ir.ui.view">
        <field name="name">aveenix.news.detail.affiliate</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="aveenix_website.news_detail_template"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('av-article-body')]" position="replace">
                <div class="av-article-body mb-5"
                     style="font-size: 1.0625rem; line-height: 1.8; color: inherit;">
                    <t t-if="av_in_content_placement">
                        <t t-out="av_content_before"/>
                        <t t-set="placement" t-value="av_in_content_placement"/>
                        <t t-call="aveenix_affiliate_engine.affiliate_offer_card"/>
                        <t t-out="av_content_after"/>
                    </t>
                    <t t-else="">
                        <t t-out="article['content']"/>
                        <t t-foreach="av_after_body_placements" t-as="placement">
                            <t t-call="aveenix_affiliate_engine.affiliate_offer_card"/>
                        </t>
                    </t>
                </div>
            </xpath>

            <!-- Sidebar slot goes between Most Popular and the ad banner, so a
                 paid recommendation reads as editorial adjacency rather than as
                 part of the ad unit. -->
            <xpath expr="//div[hasclass('av-news-sidebar-widget')]" position="after">
                <t t-if="av_sidebar_placements">
                    <div class="av-news-sidebar-widget mb-5">
                        <div class="av-news-section-header mb-4">
                            <h3 class="av-news-section-title">RECOMMENDED</h3>
                        </div>
                        <t t-foreach="av_sidebar_placements" t-as="placement">
                            <t t-call="aveenix_affiliate_engine.affiliate_offer_card"/>
                        </t>
                    </div>
                </t>
            </xpath>

        </field>
    </record>

</odoo>
