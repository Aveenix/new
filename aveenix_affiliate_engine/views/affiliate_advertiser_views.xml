<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_affiliate_advertiser_list" model="ir.ui.view">
        <field name="name">affiliate.advertiser.list</field>
        <field name="model">affiliate.advertiser</field>
        <field name="arch" type="xml">
            <list string="Advertisers">
                <field name="name"/>
                <field name="network"/>
                <field name="external_id"/>
                <field name="commission_note" optional="show"/>
                <field name="offer_count" string="Offers"/>
                <field name="approved_offer_count" string="Approved"/>
                <field name="shop_import" string="To Shop" widget="boolean_toggle" optional="show"/>
                <field name="shop_last_sync" optional="hide"/>
                <field name="shop_sync_message" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_affiliate_advertiser_form" model="ir.ui.view">
        <field name="name">affiliate.advertiser.form</field>
        <field name="model">affiliate.advertiser</field>
        <field name="arch" type="xml">
            <form string="Advertiser">
                <header>
                    <button name="action_import_shop_products" type="object"
                            string="Import Products Now" class="btn-primary"
                            invisible="network != 'cj' or not shop_import"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_offers" type="object"
                                class="oe_stat_button" icon="fa-tags">
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                        <button name="action_view_shop_products" type="object"
                                class="oe_stat_button" icon="fa-shopping-bag"
                                invisible="network != 'cj'">
                            <field name="shop_product_count" widget="statinfo" string="In Shop"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Acme Supplements"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="network"/>
                            <field name="external_id"
                                   placeholder="CJ advertiser id, or ClickBank vendor nickname"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="commission_note"/>
                            <field name="program_url" widget="url"/>
                            <field name="approved_offer_count"/>
                        </group>
                    </group>
                    <group string="Shop Import" invisible="network != 'cj'">
                        <group>
                            <field name="shop_import"/>
                            <field name="shop_keywords" invisible="not shop_import"
                                   placeholder="e.g. running shoes, fitness tracker"/>
                        </group>
                        <group>
                            <field name="shop_last_sync"/>
                            <field name="shop_sync_message"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Archiving an advertiser disables every one of its offers at
                        once, without having to touch them individually.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_affiliate_advertiser_search" model="ir.ui.view">
        <field name="name">affiliate.advertiser.search</field>
        <field name="model">affiliate.advertiser</field>
        <field name="arch" type="xml">
            <search string="Advertisers">
                <field name="name"/>
                <field name="external_id"/>
                <filter name="cj" string="CJ Affiliate" domain="[('network','=','cj')]"/>
                <filter name="clickbank" string="ClickBank" domain="[('network','=','clickbank')]"/>
                <separator/>
                <filter name="shop_import" string="Importing to Shop"
                        domain="[('shop_import','=',True)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                <group>
                    <filter name="group_network" string="Network" context="{'group_by':'network'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_affiliate_advertiser" model="ir.actions.act_window">
        <field name="name">Advertisers</field>
        <field name="res_model">affiliate.advertiser</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_affiliate_advertiser_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No advertisers yet.</p>
            <p>
                CJ advertisers appear here automatically once the CJ token and
                Publisher ID are set in Website Settings. Add ClickBank vendors
                by hand, using the vendor nickname as the Network ID.
            </p>
        </field>
    </record>

</odoo>
